# Copy to .env and fill in real values. .env is private and never committed (B.1).

# Long random string. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# False for daily use: error pages never show code or settings (D-96). True only while developing.
DJANGO_DEBUG=False
# Comma-separated host names the app answers to (D-03)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Sign-up only accepts emails ending with this domain
COMPANY_EMAIL_DOMAIN=@yourcompany.com
# Deadlines (Saturday 12:00) are computed in this time zone
COMPANY_TZ=America/Chicago
# Sunday that starts pay period 1 (biweekly periods count from here). Weeks run Sunday to
# Saturday, so this must be a Sunday or the app refuses to start (D-111, D-113).
PAY_PERIOD_ANCHOR=2026-01-04

# Password for every seed_demo login account (at least 12 characters, not a common password)
DEMO_PASSWORD=choose-a-strong-demo-password
